{
  "name": "dhaam-ccrm-sdk",
  "version": "0.0.0",
  "private": true,
  "description": "Framework-agnostic chat SDK \u2014 plain-TypeScript core plus thin framework bindings",
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "dev:widget": "pnpm --filter @dhaam-ccrm/widget dev:harness",
    "dev:widget:watch": "pnpm --filter @dhaam-ccrm/widget dev",
    "dev:demo": "pnpm --filter @dhaam-ccrm/demo start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck",
    "verify": "pnpm build && pnpm typecheck && pnpm test",
    "pack:check": "pnpm -r --filter \"./packages/*\" exec pnpm pack --dry-run",
    "pack:local": "pnpm build && pnpm -r --filter \"@dhaam-ccrm/browser\" --filter \"@dhaam-ccrm/core\" --filter \"@dhaam-ccrm/js\" --filter \"@dhaam-ccrm/rest\" --filter \"@dhaam-ccrm/widget\" exec pnpm pack --pack-destination .",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm verify && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dhaam-ai/chatsupport-sdk.git"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "homepage": "https://github.com/dhaam-ai/chatsupport-sdk#readme",
  "bugs": {
    "url": "https://github.com/dhaam-ai/chatsupport-sdk/issues"
  },
  "author": "Dhaam AI"
}
